rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny access to every path that is not explicitly authorized here.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function familyDoc(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }
    function memberDoc(fid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid);
    }
    function invitationDoc(fid, email) {
      return /databases/$(database)/documents/families/$(fid)/invites/$(email);
    }
    function owner(fid) {
      return verified() && exists(familyDoc(fid)) &&
        get(familyDoc(fid)).data.ownerUid == request.auth.uid;
    }
    function member(fid) {
      return verified() && (owner(fid) || exists(memberDoc(fid)));
    }
    function editor(fid) {
      return member(fid) && (
        owner(fid) || get(memberDoc(fid)).data.role == 'editor'
      );
    }
    function validRecordType(kind) {
      return kind in ['p','a','m','d','labs','vaccines','docs','vitals','symptoms','followups','record'];
    }

    match /users/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['familyId','email']) &&
        request.resource.data.keys().hasAll(['familyId','email']) &&
        request.resource.data.familyId is string &&
        request.resource.data.familyId.size() <= 50 &&
        request.resource.data.email == request.auth.token.email.lower();
      allow delete: if false;
    }

    match /families/{fid} {
      allow create: if verified() &&
        request.resource.data.keys().hasOnly(['ownerUid','name','createdAt']) &&
        request.resource.data.keys().hasAll(['ownerUid','name','createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.createdAt == request.time;
      allow get: if member(fid);
      allow list: if false;
      allow update: if owner(fid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.keys().hasOnly(['ownerUid','name','createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 80;
      allow delete: if false;

      match /invites/{email} {
        allow get: if owner(fid) ||
          (verified() && request.auth.token.email.lower() == email);
        allow list: if owner(fid);
        allow create, update: if owner(fid) &&
          request.resource.data.keys().hasOnly(['email','role','invitedBy','expiresAt','createdAt']) &&
          request.resource.data.keys().hasAll(['email','role','invitedBy','expiresAt','createdAt']) &&
          request.resource.data.email == email &&
          request.resource.data.role in ['editor','viewer'] &&
          request.resource.data.invitedBy == request.auth.uid &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt > request.time &&
          request.resource.data.expiresAt < request.time + duration.value(8,'d') &&
          request.resource.data.createdAt == request.time;
        allow delete: if owner(fid);
      }

      match /members/{uid} {
        allow get: if owner(fid) || (verified() && request.auth.uid == uid);
        allow list: if owner(fid);
        allow create: if verified() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['email','role','invitedBy','joinedAt']) &&
          request.resource.data.keys().hasAll(['email','role','invitedBy','joinedAt']) &&
          request.resource.data.email == request.auth.token.email.lower() &&
          exists(invitationDoc(fid,request.auth.token.email.lower())) &&
          get(invitationDoc(fid,request.auth.token.email.lower())).data.expiresAt > request.time &&
          request.resource.data.role == get(invitationDoc(fid,request.auth.token.email.lower())).data.role &&
          request.resource.data.invitedBy == get(invitationDoc(fid,request.auth.token.email.lower())).data.invitedBy &&
          request.resource.data.joinedAt == request.time;
        allow update: if owner(fid) &&
          request.resource.data.keys().hasOnly(['email','role','invitedBy','joinedAt']) &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.invitedBy == resource.data.invitedBy &&
          request.resource.data.joinedAt == resource.data.joinedAt &&
          request.resource.data.role in ['editor','viewer'];
        allow delete: if owner(fid) || (verified() && request.auth.uid == uid);
      }

      match /entries/{entryId} {
        allow get, list: if member(fid);
        allow create, update: if editor(fid) &&
          request.resource.data.keys().hasOnly(['kind','item','updatedAt','updatedBy']) &&
          request.resource.data.keys().hasAll(['kind','item','updatedAt','updatedBy']) &&
          validRecordType(request.resource.data.kind) &&
          request.resource.data.item is map &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time;
        allow delete: if editor(fid);
      }

      match /settings/{key} {
        allow get, list: if member(fid);
        allow create, update: if editor(fid) &&
          key in ['prefs','rec','record_patient'] &&
          request.resource.data.keys().hasOnly(['key','value','updatedAt','updatedBy']) &&
          request.resource.data.keys().hasAll(['key','value','updatedAt','updatedBy']) &&
          request.resource.data.key == key &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time;
        allow delete: if editor(fid);
      }
    }
  }
}
